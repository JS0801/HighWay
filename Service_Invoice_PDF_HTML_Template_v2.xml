<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            
<table class="header" style="width: 100%;"><tr>
<td style="width: 20%;" align="left"><#if subsidiary.logo?length != 0 > <@filecabinet nstype="image" style="margin: 7px; float: left;" src="${subsidiary.logo@url}" /> <#elseif companyInformation.logoUrl?length != 0 > <@filecabinet nstype="image" style="margin: 0px; float: left; width: 120px; height: 62.86px;" src="${companyInformation.logoUrl}" /> </#if></td>
<td style="width: 40%;"><strong><span style="font-size: 15px;">Highway Specialty Co Inc</span></strong><br /><br />P O Box 141<br />Palo Cedro CA 96073<br />(530) 949-5631</td>
<td style="width: 40%;" align="right"><span class="title"><strong>Service Invoice</strong></span> <br /><br /><strong>Invoice No.#:</strong> ${record.tranid} <br /><strong>Date:</strong> ${record.trandate} <br /><strong>Job No.:</strong> ${record.custbody4} </td>
</tr>
<tr>
<td style="width: 19.8773%;" align="center">License: 1003147</td>
</tr></table>

        </macro>
        <macro id="nlfooter">
            
<table class="footer" style="width: 100%;"><tr>
<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
<td align="right"><pagenumber/> of <totalpages/></td>
</tr></table>

        </macro>
    </macrolist>
    <style>
            * {
                <#if .locale == "zh_CN">
                font-family: NotoSans, NotoSansCJKsc, sans-serif;
                <#elseif .locale == "zh_TW">
                font-family: NotoSans, NotoSansCJKtc, sans-serif;
                <#elseif .locale == "ja_JP">
                font-family: NotoSans, NotoSansCJKjp, sans-serif;
                <#elseif .locale == "ko_KR">
                font-family: NotoSans, NotoSansCJKkr, sans-serif;
                <#elseif .locale == "th_TH">
                font-family: NotoSans, NotoSansThai, sans-serif;
                <#else>
                font-family: NotoSans, sans-serif;
                </#if>
            }
            table {
                font-size: 9pt;
                table-layout: fixed;
            }
            th {
                font-weight: bold;
                font-size: 8pt;
                vertical-align: middle;
                padding: 5px 6px 3px;
                background-color: #e3e3e3;
                color: #333333;
            }
            td {
                padding: 4px 6px;
            }
            td p { align:left }
            b {
                font-weight: bold;
                color: #333333;
            }
            table.header td {
                padding: 0px;
                font-size: 10pt;
            }
            table.footer td {
                padding: 0px;
                font-size: 8pt;
            }
            table.itemtable th {
                padding-bottom: 10px;
                padding-top: 10px;
            }
            table.body td {
                padding-top: 2px;
            }
            table.total {
                page-break-inside: avoid;
            }
            tr.totalrow {
                background-color: #e3e3e3;
                line-height: 200%;
            }
            td.totalboxtop {
                font-size: 12pt;
                background-color: #e3e3e3;
            }
            td.addressheader {
                font-size: 8pt;
                padding-top: 6px;
                padding-bottom: 2px;
            }
            td.address {
                padding-top: 0px;
            }
            td.totalboxmid {
                font-size: 28pt;
                padding-top: 20px;
                background-color: #e3e3e3;
            }
            td.totalboxbot {
                background-color: #e3e3e3;
                font-weight: bold;
            }
            span.title {
                font-size: 24px;
            }
            span.number {
                font-size: 16pt;
            }
            span.itemname {
                font-weight: bold;
                line-height: 150%;
            }
            hr {
                width: 100%;
                color: #d3d3d3;
                background-color: #d3d3d3;
                height: 1px;
            }
            table.details {
            	padding-top: 0px;
                padding-bottom: 0px;
          	    margin-top: 0px;
          	    margin-bottom: 0px;
      	    }
      	    table.details tr {
                border: 0px;
          	    border-collapse: collapse;
            }
            table.details th {
                font-size: 9pt;
          	    padding: 8px;
          	    align: center;
            }
          	table.details td {
              	font-size: 9pt;  
              	padding: 5px;
              	align: center;
              	vertical-align: middle;
              	border: .5px;
                border-color: #e3e3e3;
              	border-collapse: collapse;
            }
            
        </style>
</head>
<body header="nlheader" header-height="12%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%; margin-top: 10px;"><tr>
<td style="width: 40%;">
<table style="width: 100%;"><tr>
<td style="width: 25%;"><strong>Billed To:</strong></td>
<td style="width: 75%;">${record.billaddress}</td>
</tr></table>
</td>
<td style="width: 20%;">&nbsp;</td>
<td style="width: 40%;">
<table style="width: 100%;"><tr>
<td style="width: 25%;"><strong>Project:</strong></td>
<td style="width: 75%;">${record.cseg_bc_project}<br/>${record.cseg_bc_project.custrecord3}</td>
</tr></table>
</td>
</tr></table>

<table class="details" style="width: 100%;"><tr>
	<th>${record.otherrefnum@label?upper_case}</th>
	<th>DELIVERY DATE</th>
	<th>TERMS</th>
	<th>PAYMENT DUE</th>
	</tr>
	<tr>
	<td>${record.otherrefnum}</td>
	<td>${record.trandate}</td>
	<td>${record.terms}</td>
	<td>${record.duedate}</td>
	</tr>
</table>
  
<#if record.item?has_content>
<table style="width: 100%; margin-top: 10px;"><!-- start items --> <#list record.item as item> <#if item_index==0>
<thead>
<tr>
<th colspan="12" align="left">${item.item@label}</th>
<th colspan="4" align="left">${item.quantity@label}</th>
<!-- <th colspan="12">${item.item@label}</th> -->
<th colspan="4">Unit</th>
<th colspan="4" align="left">${item.rate@label}</th>
<th colspan="4" align="left">Ext Price</th>
<th colspan="4" align="left">Sales Tax</th>
</tr>
</thead>
</#if><tr>
<td colspan="12" align="left">${item.item}</td>
<td colspan="4" align="left">${item.quantity}</td>
<!-- <td colspan="12"><span class="itemname">${item.item}</span><br />${item.description}</td> -->
<td colspan="4">${item.custcol_nst_rrm_rental_type}</td>
<td colspan="4" align="left">${item.rate}</td>
<td colspan="4" align="left">${item.amount}</td>
<td colspan="4" align="left">${item.istaxable}</td>
</tr>
</#list> <!-- end items --></table>
</#if>
<table style="width: 100%; margin-top: 10px;"><tr>
</tr></table>
<table class="total" style="width: 100%; margin-top: 10px;"><tr>
<td colspan="8">
<table style="width: 100%;"><tr>
<td>
<p>A service charge of 18.000% per annum will be charged on all amounts overdue on regular statement dates.</p>
<p>Thank you for your prompt payment!</p>
</td>
</tr></table>
</td>
<td colspan="4">
<table style="width: 100%; border: 1px solid #181818;"><tr>
<td>${record.subtotal@label}:</td>
<td>${record.subtotal}</td>
</tr>
<tr>
<td>${record.taxtotal@label} (${record.taxrate}%):</td>
<td>${record.taxtotal}</td>
</tr>
<tr>
<td>${record.total@label}:</td>
<td>${record.total}</td>
</tr>
<tr>
<td><strong>Amount Due:</strong></td>
<td>${record.amountremaining}</td>
</tr></table>
</td>
</tr></table>
</body>
</pdf>